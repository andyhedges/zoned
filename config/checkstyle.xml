<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">

  <!-- File-level hygiene -->
  <module name="NewlineAtEndOfFile" />
  <module name="FileTabCharacter" />
  <module name="RegexpHeader">
    <property name="header" value="^// SPDX-License-Identifier: Apache-2.0$"/>
    <property name="fileExtensions" value="java"/>
  </module>
  <module name="TreeWalker">
    <module name="UnusedImports" />
    <module name="MissingOverride"/>
    <module name="EmptyBlock">
      <property name="option" value="text" />
    </module>
    <module name="NeedBraces" />
    <module name="AvoidNestedBlocks" />
    <module name="MatchXpath">
      <property name="query"
            value="//VARIABLE_DEF[./TYPE/IDENT[@text='var']]" />
      <message key="matchxpath.match" value="Avoid 'var'; use an explicit type."/>
    </module>
    <module name="RegexpSinglelineJava">
      <property name="format" value="\bSystem\.(out|err)\.(print|println|printf|format|append|write)\b"/>
      <message key="regexp.singlelinejava" value="Avoid System.out/System.err output; use a logger."/>
    </module>
    <module name="RegexpSinglelineJava">
      <property name="format" value="\bprintStackTrace\s*\("/>
      <message key="regexp.singlelinejava" value="Avoid printStackTrace; use a logger."/>
    </module>
    <module name="RegexpSinglelineJava">
      <property name="format" value="\bnew\s+Print(?:Writer|Stream)\b.*System\.(out|err)\b"/>
      <message key="regexp.singlelinejava" value="Avoid wrapping System.out/System.err in PrintWriter/PrintStream; use a logger."/>
    </module>
    <module name="RegexpSinglelineJava">
      <property name="format" value="\bSystem\.console\(\)\.(printf|format|append)\b"/>
      <message key="regexp.singlelinejava" value="Avoid System.console() output; use a logger."/>
    </module>

  </module>
</module>
